# Copy to .env and fill in. The key is read under either name.
# OPENROUTER_API_KEY is the canonical one; OPEN_ROUTER_KEY also works.

OPENROUTER_API_KEY=

# Optional. Defaults are shown; you only need these to override them.
# JEV_MODEL=typesafe/jev-1.13
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# JEV_MAX_CONCURRENCY=10
# JEV_MAX_RPS=20.0
# JEV_MAX_RETRIES=4
# JEV_BACKOFF_BASE=1.5
# JEV_BACKOFF_MAX=30.0
# JEV_TIMEOUT=60.0
# JEV_MAX_BATCH_SIZE=100
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=INFO
